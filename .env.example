# Create a local .env from this template. Never commit the real .env.
TELEGRAM_TOKEN=replace_with_botfather_token
AUTHORIZED_CHAT_ID=replace_with_numeric_chat_id
PERSONAL_ID=replace_with_9_digit_id
OTP_CHANNEL=phone
OTP_CONTACT=replace_with_registered_phone_or_email
HEADLESS=true
# BROWSER_EXECUTABLE=/absolute/path/to/chromium
STATE_DIR=./.rehab_checker_state
# Operational event names only; never logs private message or account data.
LOG_LEVEL=INFO
# Autonomous checks start only after /autocheck_start. Minimum interval: 15 minutes.
# This is the interval used after the command; example/default: 60.
AUTOCHECK_INTERVAL_MINUTES=60
